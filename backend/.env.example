# ============================================================
# GitPuller Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================

# GitHub personal access token (needs 'repo' scope)
GITHUB_TOKEN=your_github_token_here

# LLM Configuration (OpenRouter — access to 100+ models)
# Get your key at: https://openrouter.ai/keys
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-32b
LLM_STRUCTURED_METHOD=json_mode

# Neo4j connection (local default uses Neo4j Desktop / Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
