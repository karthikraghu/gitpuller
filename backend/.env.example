# ============================================================
# GitPuller Backend - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ============================================================

# GitHub personal access token (needs 'repo' scope)
GITHUB_TOKEN=your_github_token_here

# LLM API key (get one at https://aistudio.google.com/apikey)
LLM_API_KEY=your_llm_api_key_here

# Neo4j connection (local default uses Neo4j Desktop / Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Optionally override the default LLM model
# LLM_MODEL=gemini-2.5-flash
